#!/usr/bin/env bash
set -euo pipefail
ROOT="${UBUNTU_AI_ROOT:-/opt/ubuntu-ai}"
# shellcheck source=/dev/null
source "$ROOT/lib/models.sh"

model="${1:-local-coder}"
shift $(( $# >= 1 ? 1 : 0 ))
model_exists "$model" || { echo "Unknown model alias: $model" >&2; exit 2; }
[[ "$(model_field "$model" tools)" == "yes" ]] || {
  echo "Model $model does not advertise native tool calling in Ollama and cannot be used as an OpenCode agent model." >&2
  echo "Use it directly with: ollama run $model:latest" >&2
  exit 2
}
context="$(model_field "$model" context)"

mem_config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode-mem.jsonc"
if [[ ! -e "$mem_config" ]]; then
  mkdir -p "$(dirname "$mem_config")"
  cat >"$mem_config" <<'EOF'
{
  "storagePath": "~/.opencode-mem/data",
  "webServerEnabled": true,
  "webServerHost": "127.0.0.1",
  "webServerPort": 4747,
  "autoCaptureEnabled": true,
  "opencodeProvider": "ubuntu-local",
  "opencodeModel": "inherit",
  "showAutoCaptureToasts": true,
  "showUserProfileToasts": true,
  "showErrorToasts": true,
  "userProfileAnalysisInterval": 10,
  "maxMemories": 10,
  "compaction": {
    "enabled": true,
    "memoryLimit": 10
  },
  "chatMessage": {
    "enabled": true,
    "maxMemories": 3,
    "excludeCurrentSession": true,
    "injectOn": "first"
  }
}
EOF
fi

export OPENCODE_CONFIG_CONTENT="$(cat <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "ubuntu-local/$model:latest",
  "small_model": "ubuntu-local/local-fast:latest",
  "enabled_providers": ["ubuntu-local"],
  "plugin": [
    "opencode-mem",
    "@nick-vi/opencode-type-inject@latest",
    "@mohak34/opencode-notifier@latest",
    [
      "@prevalentware/opencode-goal-plugin",
      {
        "auto_continue": true,
        "defer_while_tasks_active": true,
        "max_auto_turns": 8,
        "min_continue_interval_seconds": 3,
        "max_turn_time": 180,
        "max_task_block_seconds": 600,
        "max_prompt_failures": 2,
        "max_goal_duration_seconds": 900,
        "no_progress_token_threshold": 50,
        "max_no_progress_turns": 2,
        "restricted_agents": ["plan"],
        "allow_goal_execution_from_plan": false
      }
    ],
    "@tarquinen/opencode-dcp@latest"
  ],
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ubuntu-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local NVIDIA GPU (bounded)",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "apiKey": "ollama",
        "timeout": 190000,
        "headerTimeout": 190000,
        "chunkTimeout": 190000
      },
      "models": {
        "local-coder:latest": {
          "name": "local-coder:latest",
          "limit": {"context": 262144, "output": 4096}
        },
        "local-fast:latest": {
          "name": "local-fast:latest",
          "limit": {"context": 262144, "output": 4096}
        },
        "local-qwen-coder:latest": {
          "name": "local-qwen-coder:latest",
          "limit": {"context": 32768, "output": 4096}
        },
        "local-gemma4-e2b:latest": {
          "name": "local-gemma4-e2b:latest",
          "limit": {"context": 131072, "output": 4096}
        },
        "local-gemma4-e4b:latest": {
          "name": "local-gemma4-e4b:latest",
          "limit": {"context": 131072, "output": 4096}
        },
        "local-gemma4-12b:latest": {
          "name": "local-gemma4-12b:latest",
          "limit": {"context": 262144, "output": 4096}
        }
      }
    }
  },
  "agent": {
    "build": {"steps": 12, "permission": {"task": "deny"}},
    "plan": {"steps": 12, "permission": {"task": "deny"}}
  }
}
EOF
)"
exec opencode "$@"
